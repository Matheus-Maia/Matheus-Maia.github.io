---
interface Props {
  date: string;
  title: string;
  body: string;
  tags?: string[];
  link?: string;
  linkLabel?: string;
  isFirst?: boolean;
}

const { date, title, body, tags = [], link, linkLabel = 'Ver mais', isFirst = false } = Astro.props;

const tagColors: Record<string, string> = {
  'estudando': 'bg-sky-100 text-sky-700',
  'deploy':    'bg-emerald-100 text-emerald-700',
  'projeto':   'bg-violet-100 text-violet-700',
  'bug fix':   'bg-rose-100 text-rose-700',
  'leitura':   'bg-amber-100 text-amber-700',
  'conquista': 'bg-orange-100 text-orange-700',
};

function tagClass(tag: string) {
  return tagColors[tag.toLowerCase()] ?? 'bg-gray-100 text-gray-600';
}
---

<div class="fade-up relative pl-8">
  <!-- Line segment (continuous, driven by parent) -->
  <!-- Dot -->
  <div 
    class={`absolute left-0 top-1 w-2.5 h-2.5 rounded-full border-2 border-accent bg-cream ring-4 ring-cream z-10 ${isFirst ? 'w-3 h-3 bg-accent border-accent' : ''}`}
  ></div>

  <!-- Date -->
  <span class="font-mono text-xs text-muted tracking-widest uppercase">{date}</span>

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-1.5">
      {tags.map(tag => (
        <span class={`font-mono text-[10px] px-2 py-0.5 rounded-full font-medium uppercase tracking-wide ${tagClass(tag)}`}>
          {tag}
        </span>
      ))}
    </div>
  )}

  <!-- Title -->
  <h3 class="font-display text-xl mt-2 leading-snug">{title}</h3>

  <!-- Body -->
  <p class="text-muted text-sm leading-relaxed mt-1.5 max-w-prose">
    {body}
  </p>

  <!-- Link -->
  {link && (
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 font-mono text-xs text-accent mt-3 hover:underline underline-offset-2 transition-opacity hover:opacity-70"
    >
      {linkLabel}
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
      </svg>
    </a>
  )}
</div>
